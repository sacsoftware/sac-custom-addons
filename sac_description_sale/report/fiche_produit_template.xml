<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_fiche_produit">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="doc">
                        <h2>Fiche Produit</h2>

                        <strong>Nom du produit :</strong>
                        <span t-esc="doc.product_tmpl_id.name"/><br/>

                        <strong>Référence :</strong>
                        <span t-esc="doc.product_tmpl_id.default_code"/><br/>

                        <br/>
                        <h3>Composants :</h3>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Quantité</th>
                                    <th>Unité</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.bom_line_ids" t-as="line">
                                    <td><span t-esc="line.product_id.name"/></td>
                                    <td><span t-esc="line.product_qty"/></td>
                                    <td><span t-esc="line.product_uom_id.name"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
